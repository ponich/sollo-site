#!/bin/sh
set -eu

APP_DIR=/root/apps/sollo-site
GIT_DIR=/root/apps/sollo-site.git
SERVICE=sollo-site
BRANCH=develop

while read -r oldrev newrev ref; do
  if [ "$ref" != "refs/heads/$BRANCH" ]; then
    echo "Skip $ref: only $BRANCH is deployed"
    continue
  fi
  echo "Deploying $newrev"
  git --work-tree="$APP_DIR" --git-dir="$GIT_DIR" checkout -f "$BRANCH"
  cp "$APP_DIR/deploy/sollo-site.service" /etc/systemd/system/$SERVICE.service
  systemctl daemon-reload
  systemctl restart $SERVICE
  sleep 3
  if systemctl is-active --quiet $SERVICE; then
    echo "Deployed: $(git --git-dir="$GIT_DIR" log -1 --format='%h %s' "$newrev")"
  else
    journalctl -u $SERVICE -n 40 --no-pager
    exit 1
  fi
done
